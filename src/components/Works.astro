---
import { projects } from "@/data/projects";

const featured = projects.find((p) => p.featured);
const standard = projects.filter((p) => !p.featured);
---

<section class="works" id="works">
	<div class="container">
		<div class="header-row">
			<div>
				<div class="eyebrow">
					<span class="rule"></span>
					02 · PROJECTS
				</div>
				<h2 class="heading">PROJECTS<span class="period">.</span></h2>
			</div>
			<div class="count">FOUR PROJECTS · 2025—2026</div>
		</div>

		{
			featured && (
				<a class="featured-card" href={featured.href}>
					<div class="media">
						<div class="placeholder">
							<span>{featured.title.toUpperCase()} — COVER</span>
						</div>
						<span class="badge mustard">FEATURED · {featured.statusLabel.toUpperCase()}</span>
					</div>
					<div class="body">
						<div>
							<div class="meta-row">
								<span>
									<span class="num">{featured.num}</span> · {featured.title.toUpperCase()}
								</span>
								<span>{featured.year}</span>
							</div>
							<h3>{featured.title}</h3>
							<p class="desc">{featured.desc}</p>
						</div>
						<div class="footer">
							<div class="pills">
								{featured.tech.map((t) => (
									<span class="pill on-paper">{t.toUpperCase()}</span>
								))}
							</div>
							<span class="view-link">VIEW PROJECT →</span>
						</div>
					</div>
				</a>
			)
		}

		<div class="grid">
			{
				standard.map((p) => (
					<a class="card" href={p.href}>
						<div class="media">
							<div class="placeholder">
								<span>{p.title.toUpperCase()} — COVER</span>
							</div>
							<span class="badge rust">{p.statusLabel.toUpperCase()}</span>
						</div>
						<div class="body">
							<div class="meta-row nowrap">
								<span>
									<span class="num">{p.num}</span> · {p.title.toUpperCase()}
								</span>
								<span>{p.meta.toUpperCase()}</span>
							</div>
							<h3>{p.title}</h3>
							<p class="desc">{p.desc}</p>
							<div class="footer">
								<div class="pills">
									{p.tech.map((t) => (
										<span class="pill on-sand">{t.toUpperCase()}</span>
									))}
								</div>
								<span class="read-link">READ →</span>
							</div>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.works {
		max-width: 1080px;
		margin: 0 auto;
		padding: 128px 48px;
	}

	.header-row {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 24px;
		flex-wrap: wrap;
		margin-bottom: 72px;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 12px;
		font-family: "JetBrains Mono", monospace;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.06em;
		color: var(--taupe);
		margin-bottom: 16px;
	}

	.eyebrow .rule {
		width: 32px;
		height: 2px;
		background: var(--mustard);
	}

	.heading {
		margin: 0;
		font-family: "Archivo", sans-serif;
		font-weight: 900;
		font-size: 88px;
		line-height: 0.9;
		letter-spacing: -0.035em;
		color: var(--moss);
	}

	.heading .period {
		color: var(--mustard);
	}

	.count {
		font-family: "JetBrains Mono", monospace;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--taupe);
		padding-bottom: 10px;
		white-space: nowrap;
	}

	/* ---------- featured card ---------- */

	.featured-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: stretch;
		background: var(--sand);
		border-radius: 24px;
		overflow: hidden;
		margin-bottom: 28px;
		color: inherit;
		text-decoration: none;
	}

	.featured-card .media {
		position: relative;
		min-width: 0;
		min-height: 300px;
		overflow: hidden;
	}

	.placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: color-mix(in srgb, var(--moss) 88%, black);
		font-family: "JetBrains Mono", monospace;
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: color-mix(in srgb, var(--paper) 45%, transparent);
		text-align: center;
		padding: 10px;
	}

	.featured-card .body {
		padding: 44px 40px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 24px;
	}

	.featured-card .meta-row {
		margin-bottom: 20px;
	}

	.featured-card h3 {
		margin: 0 0 14px;
		font-family: "Archivo", sans-serif;
		font-weight: 800;
		font-size: clamp(22px, 2.3vw, 28px);
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.featured-card .desc {
		margin: 0;
		font-size: 13.5px;
		line-height: 1.55;
		color: var(--moss);
		text-wrap: pretty;
	}

	.featured-card .pill {
		padding: 4px 9px;
		gap: 5px;
		font-size: 9px;
		background: var(--paper);
		color: var(--moss);
	}

	.view-link {
		flex-shrink: 0;
		font-family: "JetBrains Mono", monospace;
		font-size: 11px;
		font-weight: 600;
		color: var(--rust);
		white-space: nowrap;
	}

	/* ---------- shared badge / meta / pill styles ---------- */

	.badge {
		position: absolute;
		font-family: "JetBrains Mono", monospace;
		font-weight: 700;
		border-radius: 999px;
	}

	.badge.mustard {
		top: 20px;
		left: 20px;
		padding: 6px 14px;
		font-size: 10px;
		background: var(--mustard);
		color: var(--on-mustard);
	}

	.badge.rust {
		top: 14px;
		left: 14px;
		padding: 5px 11px;
		font-size: 9.5px;
		letter-spacing: 0.03em;
		background: var(--rust);
		color: var(--on-rust);
	}

	.meta-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-family: "JetBrains Mono", monospace;
		color: var(--taupe);
	}

	.meta-row .num {
		color: var(--rust);
		font-weight: 700;
	}

	.meta-row.nowrap {
		white-space: nowrap;
	}

	.pills {
		display: flex;
		flex-wrap: wrap;
	}

	.pill {
		font-family: "JetBrains Mono", monospace;
		font-weight: 600;
		border-radius: 999px;
	}

	/* ---------- standard card grid ---------- */

	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}

	.card {
		display: flex;
		flex-direction: column;
		background: var(--paper);
		border: 1.5px solid var(--card-line);
		border-radius: 20px;
		overflow: hidden;
		color: inherit;
		text-decoration: none;
	}

	.card .media {
		position: relative;
		aspect-ratio: 16 / 10;
	}

	.card .body {
		padding: 24px;
		display: flex;
		flex-direction: column;
		flex: 1;
		gap: 12px;
	}

	.card .meta-row {
		font-size: 9.5px;
	}

	.card h3 {
		margin: 0;
		font-family: "Archivo", sans-serif;
		font-weight: 800;
		font-size: 18px;
		line-height: 1.2;
		letter-spacing: -0.015em;
		color: var(--ink);
	}

	.card .desc {
		margin: 0;
		font-size: 12.5px;
		line-height: 1.5;
		color: var(--moss);
		text-wrap: pretty;
	}

	.card .footer {
		margin-top: auto;
		padding-top: 16px;
		border-top: 1px solid var(--card-line);
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.card .pills {
		gap: 5px;
	}

	.card .pill {
		padding: 3px 8px;
		font-size: 8px;
		background: var(--sand);
		color: var(--moss);
	}

	.read-link {
		font-family: "JetBrains Mono", monospace;
		font-size: 10.5px;
		font-weight: 600;
		color: var(--rust);
		white-space: nowrap;
	}

	@media (max-width: 900px) {
		.featured-card {
			grid-template-columns: 1fr;
		}
		.featured-card .media {
			min-height: 220px;
		}
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
