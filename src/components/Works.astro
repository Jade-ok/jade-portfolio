---
import { projects } from "@/data/projects";

const featured = projects.find((p) => p.featured);
const standard = projects.filter((p) => !p.featured);
---

<section class="works" id="works">
	<div class="container">
		<div class="header-row">
			<div>
				<div class="eyebrow">
					<span class="rule"></span>
					02 · PROJECTS
				</div>
				<h2 class="heading">PROJECTS<span class="period">.</span></h2>
			</div>
			<div class="count">FOUR PROJECTS · 2025-2026</div>
		</div>

		{
			featured && (
				<a class="featured-card" href={featured.href}>
					<div class="media">
						{
							featured.coverImage ? (
								<img src={featured.coverImage} alt={`${featured.title} screenshot`} loading="lazy" />
							) : (
								<div class="placeholder">
									<span>{featured.title.toUpperCase()} - COVER</span>
								</div>
							)
						}
					</div>
					<div class="body">
						<div>
							<span class="badge mustard">
								<svg class="badge-icon" aria-hidden="true" viewBox="0 0 24 24">
									<path
										fill="currentColor"
										d="M18 4V2H6v2H2v3a5 5 0 0 0 4.1 4.92A6 6 0 0 0 11 15.91V19H7v3h10v-3h-4v-3.09a6 6 0 0 0 4.9-3.99A5 5 0 0 0 22 7V4h-4ZM4 7V6h2v3.83A3 3 0 0 1 4 7Zm16 0a3 3 0 0 1-2 2.83V6h2v1Z"
									/>
								</svg>
								<span>{featured.statusLabel.toUpperCase()}</span>
							</span>
							<div class="meta-row single">
								<span>
									{featured.eyebrow.toUpperCase()} · {featured.year.toUpperCase()}
								</span>
							</div>
							<h3>{featured.title}</h3>
							<p class="desc">{featured.desc}</p>
						</div>
						<div class="footer">
							<div class="pills">
								{featured.tech.map((t) => (
									<span class="pill on-paper">{t.toUpperCase()}</span>
								))}
							</div>
							<span class="view-link">VIEW PROJECT →</span>
						</div>
					</div>
				</a>
			)
		}

		<div class="grid">
			{
				standard.map((p) => (
					<a class="card" data-project={p.slug} href={p.href}>
						<div class="media">
							{
								p.coverImage ? (
									<img src={p.coverImage} alt={`${p.title} screenshot`} loading="lazy" />
								) : (
									<div class="placeholder">
										<span>{p.title.toUpperCase()} - COVER</span>
									</div>
								)
							}
						</div>
						<div class="body">
							<div class="meta-row nowrap">
								<span class="badge rust">{p.statusLabel.toUpperCase()}</span>
								<span class="meta-year">{p.year.toUpperCase()}</span>
							</div>
							<h3>{p.title}</h3>
							<p class="desc">{p.desc}</p>
							<div class="footer">
								<div class="pills">
									{p.tech.map((t) => (
										<span class="pill on-sand">{t.toUpperCase()}</span>
									))}
								</div>
								<span class="read-link">READ →</span>
							</div>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.works {
		max-width: 1080px;
		margin: 0 auto;
		padding: 128px 48px;
		scroll-margin-top: -28px;
	}

	.header-row {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 24px;
		flex-wrap: wrap;
		margin-bottom: 72px;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 12px;
		font-family: "JetBrains Mono", monospace;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.06em;
		color: var(--taupe);
		margin-bottom: 16px;
	}

	.eyebrow .rule {
		width: 32px;
		height: 2px;
		background: var(--accent-mark);
	}

	.heading {
		margin: 0;
		font-family: "Archivo", sans-serif;
		font-weight: 900;
		font-size: 88px;
		line-height: 0.9;
		letter-spacing: -0.035em;
		color: var(--heading);
	}

	.heading .period {
		color: var(--accent-mark);
	}

	.count {
		font-family: "JetBrains Mono", monospace;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--taupe);
		padding-bottom: 10px;
		white-space: nowrap;
	}

	/* ---------- featured card ---------- */

	.featured-card {
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(300px, 0.92fr);
		align-items: stretch;
		background: var(--sand);
		border-radius: 24px;
		overflow: hidden;
		margin-bottom: 28px;
		color: inherit;
		text-decoration: none;
	}

	.featured-card .media {
		position: relative;
		min-width: 0;
		aspect-ratio: 16 / 10;
		min-height: 0;
		overflow: hidden;
		background: #050605;
	}

	.placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--sand);
		font-family: "JetBrains Mono", monospace;
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--taupe);
		text-align: center;
		padding: 10px;
	}

	.media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.featured-card .body {
		position: relative;
		z-index: 1;
		min-width: 0;
		background: var(--sand);
		padding: 40px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 22px;
	}

	.featured-card .meta-row {
		margin-bottom: 18px;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.06em;
	}

	.meta-row.single {
		justify-content: flex-start;
	}

	.featured-card h3 {
		margin: 0 0 14px;
		font-family: "Archivo", sans-serif;
		font-weight: 800;
		font-size: clamp(22px, 2.3vw, 28px);
		line-height: 1.1;
		letter-spacing: 0;
		color: var(--heading);
	}

	.featured-card .desc {
		margin: 0;
		max-width: none;
		font-size: 13.5px;
		line-height: 1.55;
		color: var(--body);
		text-wrap: pretty;
	}

	.featured-card .pill {
		padding: 4px 9px;
		font-size: 9px;
		letter-spacing: 0.03em;
		background: var(--paper);
		color: var(--body);
	}

	.featured-card .pills {
		gap: 6px;
		max-width: none;
	}

	.featured-card .footer {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 24px;
	}

	.view-link {
		flex-shrink: 0;
		font-family: "JetBrains Mono", monospace;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--accent);
		white-space: nowrap;
	}

	/* ---------- shared badge / meta / pill styles ---------- */

	/* badges sit in the card body above the copy, not over the thumbnail —
	   they read as the headline claim of each project, so they get room to
	   breathe instead of competing with the cover image */
	/* flag shape: flat left edge sits flush with the title column, the right
	   end tapers to a point. clip-path eats any border-radius, so corners
	   stay square by design. JetBrains Mono is only loaded at 400/500/600
	   (see index.astro), so font-weight caps at 600 — the text stroke carries
	   the extra weight without pulling a heavier face into every other mono
	   label on the page. */
	.badge {
		display: inline-flex;
		align-items: center;
		font-family: "JetBrains Mono", monospace;
		font-weight: 700;
		-webkit-text-stroke: 0.4px currentColor;
	}

	.badge.mustard {
		gap: 10px;
		margin-bottom: 20px;
		padding: 11px 36px 11px 18px;
		font-size: 14px;
		font-weight: 800;
		letter-spacing: 0.07em;
		-webkit-text-stroke-width: 0.55px;
		background: var(--accent-2);
		color: var(--on-accent-2);
		clip-path: polygon(0 0, calc(100% - 17px) 0, 100% 50%, calc(100% - 17px) 100%, 0 100%);
	}

	.badge-icon {
		width: 16px;
		height: 16px;
		flex: 0 0 auto;
	}

	.badge.rust {
		padding: 6px 26px 6px 12px;
		font-size: 10.5px;
		letter-spacing: 0.04em;
		white-space: nowrap;
		clip-path: polygon(0 0, calc(100% - 13px) 0, 100% 50%, calc(100% - 13px) 100%, 0 100%);
		/* filled surface — stays on --accent (not --accent-mark) so dark
		   mode's brightened mark color never lands under the cream text
		   and erodes its contrast; race explicitly wants the brighter
		   coral fill here, so it gets its own override below */
		background: var(--accent);
		color: var(--on-accent);
	}

	:global([data-jl-theme="race"]) .badge.rust {
		background: var(--accent-mark);
	}

	.meta-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-family: "JetBrains Mono", monospace;
		color: var(--taupe);
	}

	.meta-row.nowrap {
		white-space: nowrap;
	}

	.pills {
		display: flex;
		flex-wrap: wrap;
	}

	.pill {
		font-family: "JetBrains Mono", monospace;
		font-weight: 600;
		border-radius: 999px;
	}

	/* ---------- standard card grid ---------- */

	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}

	.card {
		display: flex;
		flex-direction: column;
		background: var(--paper);
		border: 1.5px solid var(--card-line);
		border-radius: 20px;
		overflow: hidden;
		color: inherit;
		text-decoration: none;
	}

	.card .media {
		position: relative;
		aspect-ratio: 16 / 10;
	}

	.card[data-project="smart-home-database"] .media {
		overflow: hidden;
	}

	.card[data-project="smart-home-database"] .media img {
		object-fit: cover;
		object-position: top center;
	}

	.card .body {
		padding: 24px;
		display: flex;
		flex-direction: column;
		flex: 1;
		gap: 12px;
	}

	.card .meta-row {
		font-size: 9.5px;
		gap: 10px;
		margin-bottom: 2px;
	}

	.card .meta-year {
		font-weight: 600;
		letter-spacing: 0.04em;
	}

	.card h3 {
		margin: 0;
		font-family: "Archivo", sans-serif;
		font-weight: 800;
		font-size: 18px;
		line-height: 1.2;
		letter-spacing: -0.015em;
		color: var(--heading);
	}

	.card .desc {
		margin: 0;
		font-size: 12.5px;
		line-height: 1.5;
		color: var(--body);
		text-wrap: pretty;
	}

	.card .footer {
		margin-top: auto;
		padding-top: 16px;
		border-top: 1px solid var(--card-line);
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.card .pills {
		gap: 5px;
	}

	.card .pill {
		padding: 3px 8px;
		font-size: 8px;
		background: var(--sand);
		color: var(--body);
	}

	.read-link {
		font-family: "JetBrains Mono", monospace;
		font-size: 10.5px;
		font-weight: 600;
		color: var(--accent-mark);
		white-space: nowrap;
	}

	/* race keeps tag-chip text on its structural teal, distinct from --body's
	   desaturated paragraph color (see global.css race token comment) */
	:global([data-jl-theme="race"]) .featured-card .pill,
	:global([data-jl-theme="race"]) .card .pill {
		color: #137f76;
	}

	@media (max-width: 1100px) {
		.featured-card {
			grid-template-columns: 1fr;
		}
		.featured-card .media {
			aspect-ratio: 16 / 9;
			min-height: 260px;
		}
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: 1fr;
		}
		.heading {
			font-size: clamp(44px, 12vw, 88px);
		}
	}

	@media (max-width: 600px) {
		.works {
			padding: 96px 20px;
		}
		.featured-card .body {
			padding: 28px 24px;
		}
		.badge.mustard {
			margin-bottom: 16px;
			padding: 9px 29px 9px 14px;
			font-size: 11.5px;
			-webkit-text-stroke-width: 0.4px;
			clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 50%, calc(100% - 14px) 100%, 0 100%);
		}
		.badge-icon {
			width: 14px;
			height: 14px;
		}
		.header-row {
			margin-bottom: 48px;
		}
		.count,
		.meta-row.nowrap {
			white-space: normal;
		}
	}
</style>
