---
const timeline = [
	{
		year: 2026,
		title: "IT Conference Organizer",
		org: "KDD - Korean Tech Professionals Nonprofit",
		location: "Vancouver, CA",
		body: "Organizing the Annual KDD Conference (200+ attendees, Aug 2026) with the Consulate General of Korea: shaping the event concept and slogan, planning hands-on workshops, curating the session program, and leading speaker outreach.",
	},
	{
		year: 2024,
		title: "Bachelor of Computer Science",
		org: "University of British Columbia",
		location: "Vancouver, CA",
		body: "Coursework in Object-Oriented Programming, Data Structures & Algorithms, Applied Machine Learning, Computer Systems, and Relational Database Systems.",
	},
	{
		year: 2019,
		title: "Customer Relations",
		org: "Starbucks & Hospitality",
		location: "Vancouver, CA",
		body: "Customer service in a fast-paced hospitality environment, plus daily sales reconciliation, inventory, and new hire training.",
	},
	{
		year: 2016,
		title: "Digital News Editing Assistant",
		org: "The Hankyoreh",
		location: "Seoul, KR",
		body: "Curated and arranged online news by editorial priority, optimizing headlines for SEO while delivering real-time updates during major live events.",
	},
	{
		year: 2011,
		title: "Assistant Producer",
		org: "Daegu Munhwa Broadcasting Corporation (MBC)",
		location: "Daegu, KR",
		body: "Oversaw production schedules and guest coordination for debate programs, and operated live slow-motion systems for sports broadcasts.",
	},
	{
		year: 2007,
		title: "B.A. in Journalism & Mass Communication",
		org: "Kyungpook National University",
		location: "Daegu, KR",
		body: "Double Major in Business Administration.",
	},
];

const mostRecentYear = Math.max(...timeline.map((t) => t.year));
---

<section class="history" id="history">
	<div class="container">
		<div class="eyebrow">
			<span class="rule"></span>
			04 · HISTORY
		</div>
		<h2 class="heading">THE PATH<span class="period">.</span></h2>

		<div class="timeline">
			{
				timeline.map((item) => (
					<div class="tl-row">
						<div class:list={["tl-year", { current: item.year === mostRecentYear }]}>
							{item.year}
							{item.year === mostRecentYear && " -"}
						</div>
						<div class="tl-content">
							<h3>{item.title}</h3>
							<div class="org">{item.org}</div>
							<p class="body">{item.body}</p>
						</div>
						<div class="tl-location">{item.location.toUpperCase()}</div>
					</div>
				))
			}
			<div class="tl-close" />
		</div>
	</div>
</section>

<style>
	.container {
		max-width: 1080px;
		margin: 0 auto;
		padding: 100px 48px;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 12px;
		font-family: "JetBrains Mono", monospace;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.06em;
		color: var(--taupe-dim);
		margin-bottom: 16px;
	}

	.eyebrow .rule {
		width: 32px;
		height: 2px;
		background: var(--accent-mark);
	}

	.heading {
		margin: 0 0 56px;
		font-family: "Archivo", sans-serif;
		font-weight: 900;
		font-size: 88px;
		line-height: 0.9;
		letter-spacing: -0.035em;
		color: var(--heading);
	}

	.heading .period {
		color: var(--accent-mark);
	}

	.timeline {
		display: flex;
		flex-direction: column;
	}

	.tl-row {
		display: grid;
		grid-template-columns: 90px 1fr 140px;
		gap: 24px;
		padding: 20px 0;
		border-top: 1px solid var(--rule);
		align-items: baseline;
	}

	.tl-close {
		border-top: 1px solid var(--rule);
	}

	.tl-year {
		font-family: "JetBrains Mono", monospace;
		font-size: 12px;
		font-weight: 700;
		color: var(--body);
	}

	.tl-year.current {
		color: var(--accent);
	}

	.tl-content h3 {
		margin: 0 0 4px;
		font-family: "Archivo", sans-serif;
		font-weight: 700;
		font-size: 17px;
		color: var(--heading);
	}

	.tl-content .org {
		margin-bottom: 5px;
		font-family: "JetBrains Mono", monospace;
		font-size: 10.5px;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--taupe-dim);
	}

	.tl-content .body {
		margin: 0;
		font-family: "Archivo", sans-serif;
		font-size: 13px;
		font-weight: 400;
		line-height: 1.45;
		color: var(--body);
	}

	.tl-location {
		font-family: "JetBrains Mono", monospace;
		font-size: 10px;
		font-weight: 600;
		color: var(--taupe-dim);
		text-align: right;
	}

	@media (max-width: 900px) {
		.heading {
			font-size: clamp(44px, 12vw, 88px);
		}
	}

	@media (max-width: 768px) {
		.tl-row {
			display: grid;
			grid-template-columns: 1fr auto;
			grid-template-areas:
				"year location"
				"content content";
			gap: 6px 12px;
		}
		.tl-year {
			grid-area: year;
		}
		.tl-location {
			grid-area: location;
			text-align: right;
		}
		.tl-content {
			grid-area: content;
		}
	}

	@media (max-width: 600px) {
		.container {
			padding: 64px 20px;
		}
		.heading {
			margin-bottom: 40px;
		}
	}
</style>
