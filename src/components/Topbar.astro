---
// Sticky topbar navigation — shows on every page
const isHome = Astro.url.pathname === "/";
const hash = (id: string) => (isHome ? `#${id}` : `/#${id}`);
---

<header class="topbar" id="topbar">
	<div class="topbar-inner">
		<a href={isHome ? "#top" : "/"} class="brand">JADE LEE<span class="period">.</span></a>
		<div class="nav-right">
			<nav class="nav-links" aria-label="Primary">
				<a href={hash("about")}><span class="num">01</span>ABOUT</a>
				<a href={hash("works")}><span class="num">02</span>PROJECTS</a>
				<a href={hash("toolset")}><span class="num">03</span>TOOLSET</a>
				<a href={hash("history")}><span class="num">04</span>THE PATH</a>
				<a href={hash("contact")}><span class="num">05</span>LET'S CONNECT</a>
			</nav>
			<div class="theme-switch" id="theme-switch" role="group" aria-label="Theme">
				<button type="button" class="theme-swatch swatch-light" data-theme-choice="light" aria-label="Light theme">
					<svg aria-hidden="true" viewBox="0 0 20 20">
						<circle cx="10" cy="10" r="3.4"></circle>
						<path d="M10 2.2v1.8"></path>
						<path d="M10 16v1.8"></path>
						<path d="M2.2 10h1.8"></path>
						<path d="M16 10h1.8"></path>
						<path d="m4.6 4.6 1.3 1.3"></path>
						<path d="m14.1 14.1 1.3 1.3"></path>
						<path d="m15.4 4.6-1.3 1.3"></path>
						<path d="m5.9 14.1-1.3 1.3"></path>
					</svg>
				</button>
				<button type="button" class="theme-swatch swatch-dark" data-theme-choice="dark" aria-label="Dark theme">
					<svg aria-hidden="true" viewBox="0 0 20 20">
						<path d="M17.2 12.1A7.2 7.2 0 0 1 7.9 2.8a7.3 7.3 0 1 0 9.3 9.3Z"></path>
					</svg>
				</button>
				<button type="button" class="theme-swatch swatch-race" data-theme-choice="race" aria-label="Race theme">
					<svg aria-hidden="true" viewBox="0 0 20 20">
						<circle class="race-half-a" cx="10" cy="10" r="6.5"></circle>
						<path class="race-half-b" d="M10 3.5a6.5 6.5 0 0 1 0 13z"></path>
					</svg>
				</button>
			</div>
			<button type="button" class="menu-toggle" id="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-nav">
				<span class="bar"></span>
				<span class="bar"></span>
				<span class="bar"></span>
			</button>
		</div>
	</div>
</header>

<nav class="mobile-nav" id="mobile-nav" aria-label="Primary mobile">
	<a href={hash("about")}><span class="num">01</span>ABOUT</a>
	<a href={hash("works")}><span class="num">02</span>PROJECTS</a>
	<a href={hash("toolset")}><span class="num">03</span>TOOLSET</a>
	<a href={hash("history")}><span class="num">04</span>THE PATH</a>
	<a href={hash("contact")}><span class="num">05</span>LET'S CONNECT</a>
</nav>

<script>
	const themeSwitch = document.getElementById("theme-switch");
	const swatches = Array.from(
		document.querySelectorAll<HTMLButtonElement>(".theme-swatch"),
	);

	function syncActiveSwatch() {
		const current = document.documentElement.getAttribute("data-jl-theme") || "light";
		swatches.forEach((s) => {
			const isActive = s.dataset.themeChoice === current;
			s.classList.toggle("is-active", isActive);
			s.setAttribute("aria-pressed", String(isActive));
		});
	}

	if (themeSwitch) {
		swatches.forEach((s) => {
			s.addEventListener("click", () => {
				document.dispatchEvent(
					new CustomEvent("jl-theme-change", { detail: { theme: s.dataset.themeChoice } }),
				);
				syncActiveSwatch();
			});
		});
		syncActiveSwatch();
	}

	const menuToggle = document.getElementById("menu-toggle") as HTMLButtonElement | null;
	const mobileNav = document.getElementById("mobile-nav");
	const topbar = document.getElementById("topbar");

	function closeMobileNav() {
		mobileNav?.classList.remove("is-open");
		menuToggle?.setAttribute("aria-expanded", "false");
		topbar?.classList.remove("menu-is-open");
	}

	if (menuToggle && mobileNav) {
		menuToggle.addEventListener("click", () => {
			const isOpen = mobileNav.classList.toggle("is-open");
			menuToggle.setAttribute("aria-expanded", String(isOpen));
			topbar?.classList.toggle("menu-is-open", isOpen);
		});

		mobileNav.querySelectorAll("a").forEach((a) => {
			a.addEventListener("click", closeMobileNav);
		});

		window.addEventListener("resize", () => {
			if (window.innerWidth > 800) closeMobileNav();
		});
	}
</script>

<style>
	.topbar {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--nav-bg);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--hairline);
	}

	.topbar-inner {
		height: 72px;
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 48px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}

	.brand {
		font-family: "Archivo", sans-serif;
		font-size: 18px;
		font-weight: 600;
		letter-spacing: 0;
		color: var(--heading);
		text-decoration: none;
		white-space: nowrap;
	}

	.brand .period {
		color: var(--accent-mark);
	}

	.nav-right {
		display: flex;
		align-items: center;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.nav-links a {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 8px 12px;
		border-bottom: 2px solid transparent;
		color: var(--body);
		font-family: "JetBrains Mono", monospace;
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.02em;
		text-decoration: none;
		white-space: nowrap;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.nav-links a .num {
		color: var(--body);
		opacity: 0.5;
	}

	.nav-links a.is-active {
		color: var(--ink);
		font-weight: 600;
		border-bottom-color: var(--accent-mark);
	}

	.nav-links a.is-active .num {
		color: var(--accent);
		opacity: 1;
	}

	.theme-switch {
		display: flex;
		align-items: center;
		gap: 2px;
		margin-left: 16px;
		padding: 3px;
		flex-shrink: 0;
		border: 1px solid var(--card-line);
		border-radius: 999px;
	}

	.theme-swatch {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 26px;
		height: 26px;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: transparent;
		color: var(--taupe);
		cursor: pointer;
		opacity: 0.6;
		transition:
			color 0.18s ease,
			opacity 0.18s ease,
			background 0.18s ease;
	}

	.theme-swatch svg {
		width: 15px;
		height: 15px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
		display: block;
	}

	.swatch-dark svg {
		fill: currentColor;
		stroke: none;
	}

	.race-half-a {
		fill: #7e5cb0;
	}

	.race-half-b {
		fill: #117e76;
	}

	.theme-swatch:hover {
		color: var(--ink);
		opacity: 0.85;
		background: var(--sand);
	}

	.theme-swatch.is-active {
		color: var(--ink);
		opacity: 1;
		background: var(--sand);
	}

	/* ---------- mobile menu toggle + panel ---------- */

	.menu-toggle {
		display: none;
		width: 34px;
		height: 34px;
		margin-left: 8px;
		padding: 0;
		flex-shrink: 0;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 5px;
		background: transparent;
		border: 1px solid var(--card-line);
		border-radius: 0;
		cursor: pointer;
	}

	.menu-toggle .bar {
		width: 16px;
		height: 1.5px;
		background: var(--body);
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
	}

	.topbar.menu-is-open .menu-toggle .bar:nth-child(1) {
		transform: translateY(6.5px) rotate(45deg);
	}

	.topbar.menu-is-open .menu-toggle .bar:nth-child(2) {
		opacity: 0;
	}

	.topbar.menu-is-open .menu-toggle .bar:nth-child(3) {
		transform: translateY(-6.5px) rotate(-45deg);
	}

	.mobile-nav {
		display: none;
		position: sticky;
		top: 72px;
		z-index: 49;
		flex-direction: column;
		background: var(--nav-bg);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--hairline);
	}

	.mobile-nav.is-open {
		display: flex;
	}

	.mobile-nav a {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 16px 24px;
		border-top: 1px solid var(--hairline);
		color: var(--body);
		font-family: "JetBrains Mono", monospace;
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.02em;
		text-decoration: none;
	}

	.mobile-nav a .num {
		color: var(--accent);
		opacity: 0.7;
	}

	@media (max-width: 800px) {
		.topbar-inner {
			padding: 0 24px;
		}
		.nav-links {
			display: none;
		}
		.menu-toggle {
			display: flex;
		}
	}
</style>
