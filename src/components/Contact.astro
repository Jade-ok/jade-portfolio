---
const email = "jade.jinoklee@gmail.com";
const lastUpdated = new Date().toISOString().slice(0, 10);

const links = [
	{
		name: "GitHub",
		sub: "JADE-OK",
		href: "https://github.com/Jade-ok",
		icon: "M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.94.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.1-3.2.7-3.88-1.36-3.88-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.44-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.24 2.75.12 3.04.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.15 0 1.55-.01 2.8-.01 3.18 0 .3.2.66.79.55A10.52 10.52 0 0 0 23.5 12c0-6.27-5.23-11.5-11.5-11.5z",
	},
	{
		name: "LinkedIn",
		sub: "JADE LEE · VANCOUVER, CA",
		href: "https://www.linkedin.com/in/jade-lee-86bbab219",
		icon: "M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z",
	},
	{
		name: "Blog",
		sub: "NOTES ON BUILDING",
		href: "/posts/",
		icon: "M4 11a9 9 0 0 1 9 9h-2a7 7 0 0 0-7-7v-2zm0-5a14 14 0 0 1 14 14h-2A12 12 0 0 0 4 8V6zm0 9a5 5 0 0 1 5 5H7a3 3 0 0 0-3-3v-2z",
	},
];
---

<section class="connect" id="contact">
	<div class="container">
		<div class="eyebrow">
			<span class="rule"></span>
			05 · LET'S CONNECT
		</div>
		<h2 class="heading">
			HEY - I'D LOVE<br />
			TO CONNECT<span class="period">.</span>
		</h2>
		<p class="lede">Internships, interesting projects, or coffee in Vancouver - the box below reaches me directly.</p>

		<div class="grid">
			<form class="form" id="contact-form">
				<div class="row">
					<div>
						<label for="cf-name">NAME</label>
						<input id="cf-name" name="name" type="text" placeholder="Your name" required />
					</div>
					<div>
						<label for="cf-email">EMAIL</label>
						<input id="cf-email" name="email" type="email" placeholder="you@company.com" required />
					</div>
				</div>
				<div>
					<label for="cf-message">MESSAGE</label>
					<textarea id="cf-message" name="message" rows="4" placeholder="What are you building?" required
					></textarea>
				</div>
				<button type="submit" id="cf-submit">
					<span id="cf-submit-label">SEND MESSAGE</span>
					<span aria-hidden="true">→</span>
				</button>
				<p class="form-status" id="cf-status" role="status" aria-live="polite"></p>
			</form>

			<div class="links">
				<div class="link-top-rule" />
				{
					links.map((l) => (
						<a class="link-row" href={l.href} target={l.href.startsWith("http") ? "_blank" : undefined} rel={l.href.startsWith("http") ? "noopener" : undefined}>
							<svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d={l.icon} />
							</svg>
							<span class="link-text">
								<span class="link-name">{l.name}</span>
								<span class="link-sub">{l.sub}</span>
							</span>
							<span class="link-arrow" aria-hidden="true">↗</span>
						</a>
					))
				}

				<div class="email-option">
					<div class="email-label">PREFER EMAIL?</div>
					<button type="button" class="email-address" id="email-copy" data-email={email}>
						{email.toUpperCase()}
					</button>
					<span class="copied-toast" id="email-toast">COPIED ✓</span>
				</div>
			</div>
		</div>

		<div class="bottom-bar">
			<div>© 2026 JADE LEE · BUILT IN VANCOUVER</div>
			<div class="status">
				<span class="status-dot"></span>
				ONLINE · LAST UPDATED {lastUpdated}
			</div>
		</div>
	</div>
</section>

<script>
	const emailBtn = document.getElementById("email-copy") as HTMLButtonElement | null;
	const emailToast = document.getElementById("email-toast") as HTMLSpanElement | null;

	if (emailBtn && emailToast) {
		let hideTimer: ReturnType<typeof setTimeout> | undefined;

		emailBtn.addEventListener("click", async () => {
			const email = emailBtn.dataset.email || "";

			try {
				await navigator.clipboard.writeText(email);

				emailToast.classList.add("is-visible");
				clearTimeout(hideTimer);
				hideTimer = setTimeout(() => {
					emailToast.classList.remove("is-visible");
				}, 2000);
			} catch (err) {
				console.error("Failed to copy email:", err);
			}
		});
	}

	const form = document.getElementById("contact-form") as HTMLFormElement | null;
	const status = document.getElementById("cf-status") as HTMLParagraphElement | null;
	const submitBtn = document.getElementById("cf-submit") as HTMLButtonElement | null;
	const submitLabel = document.getElementById("cf-submit-label") as HTMLSpanElement | null;

	const ENDPOINT = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT as string | undefined;

	if (form && status && submitBtn && submitLabel) {
		form.addEventListener("submit", async (e) => {
			e.preventDefault();

			if (!ENDPOINT) {
				status.textContent = "Form isn't wired to a backend yet - email me directly below.";
				status.classList.add("is-error");
				return;
			}

			submitBtn.disabled = true;
			submitLabel.textContent = "SENDING...";
			status.textContent = "";
			status.classList.remove("is-error");

			try {
				const res = await fetch(ENDPOINT, {
					method: "POST",
					headers: { Accept: "application/json" },
					body: new FormData(form),
				});

				if (res.ok) {
					status.textContent = "Message sent - thanks, I'll get back to you soon.";
					form.reset();
				} else {
					throw new Error("Request failed");
				}
			} catch {
				status.textContent = "Something went wrong - email me directly below instead.";
				status.classList.add("is-error");
			} finally {
				submitBtn.disabled = false;
				submitLabel.textContent = "SEND MESSAGE";
			}
		});
	}
</script>

<style>
	.connect {
		background: var(--greige);
		color: var(--ink);
		padding: 105px 0 48px;
		border-top: 1px solid var(--rule);
		scroll-margin-top: -20px;
	}

	.container {
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 48px;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 12px;
		font-family: "JetBrains Mono", monospace;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.06em;
		color: var(--taupe-dim);
		margin-bottom: 22px;
	}

	.eyebrow .rule {
		width: 32px;
		height: 2px;
		background: var(--accent-mark);
	}

	.heading {
		margin: 0 0 16px;
		font-family: "Archivo", sans-serif;
		font-weight: 900;
		font-size: clamp(48px, 7vw, 84px);
		line-height: 0.88;
		letter-spacing: -0.045em;
		color: var(--heading);
	}

	.heading .period {
		color: var(--accent-mark);
	}

	.lede {
		margin: 0 0 48px;
		max-width: 460px;
		font-family: "Fraunces", serif;
		font-size: 17px;
		font-weight: 400;
		line-height: 1.45;
		color: var(--stone);
		text-wrap: pretty;
	}

	.grid {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		gap: 52px;
		align-items: start;
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 600px) {
		.container {
			padding: 0 20px;
		}
		.connect {
			padding: 80px 0 40px;
		}
		.form .row {
			grid-template-columns: 1fr;
		}
		.link-sub {
			white-space: normal;
		}
		.bottom-bar {
			margin-top: 64px;
		}
	}

	/* ---------- form ---------- */

	.form {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.form .row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px;
	}

	.form label {
		display: block;
		margin-bottom: 7px;
		font-family: "JetBrains Mono", monospace;
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--taupe-dim);
	}

	.form input,
	.form textarea {
		width: 100%;
		box-sizing: border-box;
		background: var(--field);
		border: 1px solid var(--rule);
		border-radius: 0;
		color: var(--ink);
		padding: 13px 14px;
		font-family: "Archivo", sans-serif;
		font-size: 14px;
		outline: none;
	}

	.form textarea {
		resize: vertical;
	}

	/* placeholder color is set globally in global.css (#contact ::placeholder)
	   so it can carry its own literal dark-mode value per spec */

	.form button {
		align-self: flex-start;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		background: var(--accent);
		color: var(--on-accent);
		border: none;
		border-radius: 0;
		padding: 14px 28px;
		font-family: "JetBrains Mono", monospace;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.04em;
		cursor: pointer;
	}

	.form button:disabled {
		opacity: 0.6;
		cursor: default;
	}

	.form-status {
		margin: 0;
		font-family: "JetBrains Mono", monospace;
		font-size: 10.5px;
		font-weight: 600;
		color: var(--body);
		min-height: 1.4em;
	}

	.form-status.is-error {
		color: var(--accent);
	}

	/* ---------- links ---------- */

	.links {
		display: flex;
		flex-direction: column;
	}

	.link-top-rule {
		border-top: 1px solid var(--rule);
	}

	.link-row {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 13px 0;
		border-bottom: 1px solid var(--rule);
		color: var(--ink);
		text-decoration: none;
	}

	.link-row .icon {
		width: 16px;
		height: 16px;
		flex-shrink: 0;
		color: var(--accent);
	}

	.link-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.link-name {
		font-family: "Archivo", sans-serif;
		font-size: 14px;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--ink);
	}

	.link-sub {
		font-family: "JetBrains Mono", monospace;
		font-size: 9.5px;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--taupe-dim);
		white-space: nowrap;
	}

	.link-arrow {
		margin-left: auto;
		font-family: "JetBrains Mono", monospace;
		font-size: 12px;
		color: var(--accent-mark);
	}

	.email-option {
		position: relative;
		margin-top: 18px;
	}

	.email-label {
		font-family: "JetBrains Mono", monospace;
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.05em;
		line-height: 1.8;
		color: var(--taupe-dim);
	}

	.email-address {
		display: inline-block;
		background: none;
		border: none;
		padding: 0;
		font-family: "JetBrains Mono", monospace;
		font-size: 12px;
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
		cursor: pointer;
	}

	.copied-toast {
		position: absolute;
		top: calc(100% + 8px);
		left: 0;
		padding: 5px 10px;
		background: var(--accent-2);
		color: var(--on-accent-2);
		font-family: "JetBrains Mono", monospace;
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.08em;
		border-radius: 999px;
		opacity: 0;
		pointer-events: none;
		transform: translateY(-4px);
		transition:
			opacity 0.3s ease,
			transform 0.3s ease;
	}

	.copied-toast.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	/* ---------- bottom bar ---------- */

	.bottom-bar {
		margin-top: 88px;
		padding-top: 20px;
		border-top: 1px solid var(--rule);
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 20px;
		flex-wrap: wrap;
		font-family: "JetBrains Mono", monospace;
		font-size: 10px;
		font-weight: 600;
		color: var(--taupe-dim);
	}

	.status {
		display: flex;
		align-items: center;
		gap: 7px;
	}

	.status-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent-mark);
	}
</style>
