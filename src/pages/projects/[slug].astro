---
import Animations from "@/components/Animations.astro";
import BaseHead from "@/components/BaseHead.astro";
import JLThemeProvider from "@/components/JLThemeProvider.astro";
import ProjectDetail from "@/components/ProjectDetail.astro";
import SiteOverlay from "@/components/SiteOverlay.astro";
import Topbar from "@/components/Topbar.astro";
import { getProject, projects } from "@/data/projects";
import { getProjectDetailContent } from "@/data/projectDetails";

export function getStaticPaths() {
	return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = getProject(slug as string);
const detail = project ? getProjectDetailContent(project.slug) : undefined;

if (!project || !detail) {
	return Astro.redirect("/404");
}
---

<html lang="en">
	<head>
		<JLThemeProvider />
		<BaseHead description={project.desc} title={`${project.title} - Jade Lee`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&display=swap"
		/>
	</head>
	<body>
		<SiteOverlay cursor={false} />
		<Topbar />
		<main class="detail-page">
			<ProjectDetail project={detail} />
		</main>
		<Animations />
	</body>
</html>

<style is:global>
	html,
	body {
		background: var(--paper);
		color: var(--ink);
	}
	.detail-page {
		font-family: "Archivo", sans-serif;
	}
</style>
