---
import Animations from "@/components/Animations.astro";
import Contact from "@/components/Contact.astro";
import FaviconLinks from "@/components/FaviconLinks.astro";
import Hero from "@/components/Hero.astro";
import History from "@/components/History.astro";
import JLThemeProvider from "@/components/JLThemeProvider.astro";
import SiteOverlay from "@/components/SiteOverlay.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import Toolset from "@/components/Toolset.astro";
import Topbar from "@/components/Topbar.astro";
import Works from "@/components/Works.astro";
import { siteConfig } from "@/site.config";
import "@/styles/global.css";
---

<!doctype html>
<html lang={siteConfig.lang}>
	<head>
		<ThemeProvider />
		<JLThemeProvider />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Jade Lee</title>
		<FaviconLinks />
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&display=swap"
		/>
	</head>
	<body>
		<SiteOverlay cursor={false} />
		<Topbar />
		<Hero />
		<Works />
		<Toolset />
		<History />
		<Contact />
		<Animations />
	</body>
</html>

<style is:global>
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}
	html {
		overflow-x: hidden;
	}
	html,
	body {
		background: var(--paper);
		color: var(--ink);
		font-family:
			"Pretendard",
			-apple-system,
			BlinkMacSystemFont,
			system-ui,
			sans-serif;
	}
</style>
